# 蓝心同行 FastAPI 本地配置样例
# 复制为 .env 后按需填写；不要提交真实密钥。

LANXIN_APP_NAME=蓝心同行 API
LANXIN_APP_VERSION=0.1.0
LANXIN_API_PREFIX=/api
LANXIN_DATABASE_URL=sqlite:///./lanxin_travelmate.db
LANXIN_LOG_LEVEL=INFO

# 模型 Provider：mock | lanxin | openai
LANXIN_MODEL_PROVIDER=mock
LANXIN_MODEL_TIMEOUT_SECONDS=20
LANXIN_LANXIN_BASE_URL=
LANXIN_LANXIN_API_KEY=
LANXIN_LANXIN_MODEL=lanxin
LANXIN_OPENAI_BASE_URL=
LANXIN_OPENAI_API_KEY=
LANXIN_OPENAI_MODEL=gpt-4o-mini

# 高德地图/天气/POI/路线工具；不填时返回 provider=unconfigured 的明确降级结果。
LANXIN_AMAP_BASE_URL=https://restapi.amap.com
LANXIN_AMAP_API_KEY=
LANXIN_TOOL_TIMEOUT_SECONDS=8

# Auth/JWT；生产环境必须覆盖默认 secret。
LANXIN_AUTH_TOKEN_SECRET=change-me-in-production
LANXIN_AUTH_TOKEN_TTL_SECONDS=2592000
